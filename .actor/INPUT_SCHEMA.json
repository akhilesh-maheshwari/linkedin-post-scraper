{
  "title": "LinkedIn Post Scraper",
  "description": "Scrape comments and reactions from LinkedIn posts",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "postUrls": {
      "title": "Post URLs or IDs",
      "type": "array",
      "description": "Enter LinkedIn post URLs or post IDs (e.g. https://www.linkedin.com/posts/... or 73023469261...)",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": ["https://www.linkedin.com/posts/google_googleio-io25-gemini-activity-7330295765424046080-nSW4"]
    },
    "fileName": {
      "title": "Results File Name",
      "type": "string",
      "description": "Name your results file (without extension)",
      "editor": "textfield",
      "default": "linkedin-post-scraper-output"
    }
  },
  "required": ["postUrls", "fileName"]
}
